# ===== Web (Next.js) — variables de entorno =====

# Postgres propio (Railway): el MISMO que usa el ETL para guardar snapshots.
DATABASE_URL=postgresql://user:password@host:5432/railway

# URL pública del servicio ETL en Railway (sin slash final).
# El botón "forzar actualización" hace POST a {ETL_URL}/run.
ETL_URL=https://proper-pauta-etl.up.railway.app

# Debe coincidir con ETL_TRIGGER_SECRET del servicio ETL (si lo configuraste).
ETL_TRIGGER_SECRET=cambiar-por-un-secret-largo
