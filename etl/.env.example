# ===== ETL del dashboard de pauta — variables de entorno =====
# Copiá a .env (local) o seteá como secrets en Railway. NO commitear valores reales.

# --- Postgres propio (Railway): donde el ETL guarda los snapshots ---
DATABASE_URL=postgresql://user:password@host:5432/railway

# --- Proxy n8n para queries al RDS (n8n ya está allowlistado en el RDS) ---
# URL del webhook que ejecuta SQL contra bitrix.* y devuelve JSON.
N8N_WEBHOOK_URL=https://primary-production-0299.up.railway.app/webhook/rds-proxy
# Secret compartido: el workflow n8n valida el header X-Proxy-Secret contra esto.
N8N_PROXY_SECRET=cambiar-por-un-secret-largo

# --- Disparo del ETL (POST /run) ---
# La web manda el header X-Trigger-Secret; debe coincidir con esto. Si se deja
# vacío, /run queda sin protección (NO recomendado en producción).
ETL_TRIGGER_SECRET=cambiar-por-un-secret-largo
# Timeout (segundos) del subproceso build_data.py. Default 300.
ETL_RUN_TIMEOUT=300

# --- Meta Ads (System User "BotPress", sin expiry) ---
META_TOKEN=EAAxxxxx...

# --- Google Ads OAuth ---
GOOGLE_REFRESH_TOKEN=1//0xxxxx...
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxx
GOOGLE_DEVELOPER_TOKEN=xxxxx
GOOGLE_LOGIN_CUSTOMER_ID=8961854752

# --- Flags de comportamiento ---
# true  = queries al RDS por n8n (producción / Railway)
# false = psycopg2 directo al RDS (debug local SOLO si tu IP está allowlistada)
USE_N8N=true
# true = además de Postgres, escribe data.json local (para debug / diff de regresión)
WRITE_DATA_JSON=false
# Solo si USE_N8N=false: conexión directa al RDS para debug local.
# Formato: postgresql://user:password@host:5432/dbname
RDS_DATABASE_URL=
